{
  "id": "com.rickd.devicewatchdog",
  "version": "1.3.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Device Watchdog",
    "de": "Device Watchdog"
  },
  "description": {
    "en": "Watches your devices for connectivity and battery issues, with fully customizable rules per device.",
    "de": "Überwacht deine Geräte auf Erreichbarkeits- und Batterieprobleme, mit frei konfigurierbaren Regeln pro Gerät."
  },
  "category": "tools",
  "brandColor": "#2E7D32",
  "permissions": [
    "homey:manager:api"
  ],
  "support": "mailto:ric.dubs@gmail.com",
  "source": "https://github.com/RickD-CH/com.rickd.devicewatchdog",
  "bugs": {
    "url": "https://github.com/RickD-CH/com.rickd.devicewatchdog/issues"
  },
  "homeyCommunityTopicId": 157537,
  "contributing": {
    "donate": {
      "paypal": {
        "username": "RickDch"
      }
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Richard Dubs",
    "email": "ric.dubs@gmail.com"
  },
  "api": {
    "getConfig": {
      "method": "get",
      "path": "/config"
    },
    "saveConfig": {
      "method": "post",
      "path": "/config"
    },
    "getStatus": {
      "method": "get",
      "path": "/status"
    },
    "getRawDevices": {
      "method": "get",
      "path": "/devices/raw"
    },
    "runScan": {
      "method": "post",
      "path": "/scan"
    },
    "testDevice": {
      "method": "post",
      "path": "/devices/:id/test"
    },
    "getLog": {
      "method": "get",
      "path": "/log"
    },
    "clearLog": {
      "method": "delete",
      "path": "/log"
    }
  }
}