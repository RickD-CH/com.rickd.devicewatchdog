{
  "id": "com.rickd.devicewatchdog",
  "version": "1.7.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Device Watchdog",
    "de": "Device Watchdog"
  },
  "description": {
    "en": "Battery, connectivity, and data-freshness monitoring for all your Homey devices.",
    "de": "Batterie-, Erreichbarkeits- und Aktualitäts-Überwachung für alle deine Homey-Geräte."
  },
  "category": "tools",
  "brandColor": "#2E7D32",
  "permissions": [
    "homey:manager:api"
  ],
  "support": "https://community.homey.app/t/157537",
  "source": "https://github.com/RickD-CH/com.rickd.devicewatchdog",
  "bugs": {
    "url": "https://github.com/RickD-CH/com.rickd.devicewatchdog/issues"
  },
  "homeyCommunityTopicId": 157537,
  "contributing": {
    "donate": {
      "paypal": {
        "username": "RickDch"
      }
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Richard Dubs"
  },
  "api": {
    "getConfig": {
      "method": "get",
      "path": "/config"
    },
    "saveConfig": {
      "method": "post",
      "path": "/config"
    },
    "resetSettings": {
      "method": "post",
      "path": "/settings/reset"
    },
    "getStatus": {
      "method": "get",
      "path": "/status"
    },
    "getRawDevices": {
      "method": "get",
      "path": "/devices/raw"
    },
    "runScan": {
      "method": "post",
      "path": "/scan"
    },
    "testDevice": {
      "method": "post",
      "path": "/devices/:id/test"
    },
    "getLog": {
      "method": "get",
      "path": "/log"
    },
    "clearLog": {
      "method": "delete",
      "path": "/log"
    }
  }
}