  "api": {
    "getConfig": {
      "method": "get",
      "path": "/config"
    },
    "saveConfig": {
      "method": "post",
      "path": "/config"
    },
    "resetSettings": {
      "method": "post",
      "path": "/settings/reset"
    },
    "getStatus": {
      "method": "get",
      "path": "/status"
    },
    "getRawDevices": {
      "method": "get",
      "path": "/devices/raw"
    },
    "getUnavailableStatus": {
      "method": "get",
      "path": "/devices/unavailable"
    },
    "runScan": {
      "method": "post",
      "path": "/scan"
    },
    "testDevice": {
      "method": "post",
      "path": "/devices/:id/test"
    },
    "getDeviceCapabilities": {
      "method": "get",
      "path": "/devices/:id/capabilities"
    },
    "getDeviceUpdateStats": {
      "method": "get",
      "path": "/devices/:id/stats"
    },
    "getAllUpdateStats": {
      "method": "get",
      "path": "/devices/stats"
    },
    "getLog": {
      "method": "get",
      "path": "/log"
    },
    "clearLog": {
      "method": "delete",
      "path": "/log"
    },
    "resetUpdateStats": {
      "method": "delete",
      "path": "/devices/stats"
    },
    "getStaleRules": {
      "method": "get",
      "path": "/rules/stale"
    },
    "pruneStaleRules": {
      "method": "post",
      "path": "/rules/prune"
    }
  }
}