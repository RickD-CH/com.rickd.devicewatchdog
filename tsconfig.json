{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["homey", "node"]
  },
  "include": [
    "**/*.js"
  ],
  "exclude": [
    "node_modules",
    ".homeybuild"
  ]
}
